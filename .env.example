# TripPick Environment Variables (All Optional - App works 100% offline out-of-the-box!)

# Supabase (Optional: For cross-device cloud persistence)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# OpenRouter / Gemini API (Optional: For live AI Concierge LLM queries)
VITE_OPENROUTER_API_KEY=

# Google Maps / Places API (New) (Optional: Live ratings, reviews, and verified place data)
VITE_GOOGLE_MAPS_API_KEY=

# Modular Voice Adapter (Optional: ElevenLabs HD & Google Cloud TTS)
# Note: TripPick automatically falls back to native Web Speech API and procedural audio synthesizer if omitted!
VITE_ELEVENLABS_API_KEY=
VITE_GOOGLE_TTS_API_KEY=
